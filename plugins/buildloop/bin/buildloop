#!/usr/bin/env python3
"""Deterministic workflow helpers, bundled with the BuildLoop plugin.

The `buildloop:` skills are markdown orchestrations; the small deterministic
bits they rely on live here as one self-contained, dependency-free CLI, so the
skills call one command instead of re-deriving the logic each turn:

    buildloop next-id fc
    buildloop doc-id bp 22
    buildloop open-questions docs/buildloop/working/fc-0030.md
    buildloop current-phase docs/buildloop/working/fc-0030.md
    buildloop log <doc> interview-me "created"
    buildloop log <doc> "think-gate · interview-me advances" "gate passed" --to "② Plan it"

Claude Code adds this plugin's `bin/` directory to the Bash tool's PATH while the
plugin is enabled, so `buildloop` is callable directly with no path or `python -m`.

Paths resolve against the **consuming project's working directory** (where Claude
runs), not this script's install location. The docs root defaults to
`./docs/buildloop` and is overridable with the `BUILDLOOP_DOCS_DIR` env var or the
`--docs-dir` flag.

State model: a doc's current phase is derived from its `## Log` table, never from
a status field. The table has fixed columns — `when | who | phase → | what` — and
the current phase is the To-side of the last row whose `phase →` cell carries a
transition (work rows leave it as `—`).
"""

from __future__ import annotations

import argparse
import os
import re
import sys
from pathlib import Path

# fc (feature candidate) and bp (build plan) are working docs; both live flat in
# `working/`, with shipped originals moved under `working/archive/`.
KINDS = ("fc", "bp")
WORKING_DIR = "working"
WORK_ROW_PHASE = "—"  # em dash marks an intra-phase work row (no transition)


def docs_dir(override: str | None = None) -> Path:
    """The buildloop docs root, resolved against the consuming project's cwd."""
    if override:
        return Path(override)
    env = os.environ.get("BUILDLOOP_DOCS_DIR")
    if env:
        return Path(env)
    return Path.cwd() / "docs" / "buildloop"


def next_sequence(kind: str, root: Path) -> int:
    """Return the next sequence number for a doc kind (1 if none).

    Scans `working/` recursively so archived docs still reserve their numbers —
    a shipped fc-0007 must never be reissued to a new candidate.
    """
    working = Path(root) / WORKING_DIR
    pattern = re.compile(rf"^{kind}-(\d+)\.md$")
    highest = 0
    if working.exists():
        for path in working.rglob(f"{kind}-*.md"):
            match = pattern.match(path.name)
            if match:
                highest = max(highest, int(match.group(1)))
    return highest + 1


def format_doc_id(kind: str, number: int) -> str:
    return f"{kind}-{number:04d}"


def has_open_questions(text: str) -> bool:
    """True if the doc has an `## Open Questions` section carrying a bullet."""
    match = re.search(r"(?ims)^##\s+open questions\s*$(?P<body>.*?)(?:\n##\s+|\Z)", text)
    if not match:
        return False
    # A list item: a dash/asterisk bullet or a numbered item, carrying text.
    return bool(re.search(r"(?m)^\s*(?:[-*]|\d+\.)\s+\S", match.group("body")))


# --- log table: the single source of truth for "where are we" ----------------


def _split_row(line: str) -> list[str]:
    """Cells of a markdown table row `| a | b |` → ['a', 'b'] (outer pipes dropped)."""
    return [cell.strip() for cell in line.strip().strip("|").split("|")]


def _is_separator(cells: list[str]) -> bool:
    """True for a `|---|---|` separator row (cells are only dashes/colons)."""
    return all(set(cell) <= {"-", ":"} and cell for cell in cells)


def _log_section_bounds(lines: list[str]) -> tuple[int, int] | None:
    """Return [start, end) line indices of the body under the `## Log` heading."""
    start = None
    for i, line in enumerate(lines):
        if re.match(r"(?i)^##\s+log\s*$", line):
            start = i + 1
            break
    if start is None:
        return None
    end = len(lines)
    for j in range(start, len(lines)):
        if re.match(r"^##\s+", lines[j]):
            end = j
            break
    return start, end


def _table_line_indices(lines: list[str], start: int, end: int) -> list[int]:
    """Indices of `|`-delimited table lines within [start, end)."""
    return [i for i in range(start, end) if lines[i].lstrip().startswith("|")]


def log_data_rows(text: str) -> list[list[str]]:
    """Data rows (header + separator skipped) of the `## Log` table, as cell lists."""
    lines = text.splitlines()
    bounds = _log_section_bounds(lines)
    if not bounds:
        return []
    table = _table_line_indices(lines, *bounds)
    rows = []
    for i in table:
        cells = _split_row(lines[i])
        if _is_separator(cells):
            continue
        if cells and cells[0].lower() == "when":  # header
            continue
        rows.append(cells)
    return rows


def current_phase(text: str) -> str | None:
    """The doc's current phase: To-side of the last row with a real `phase →`.

    Returns None when no transition row exists yet (doc not in the loop).
    """
    for cells in reversed(log_data_rows(text)):
        phase = cells[2] if len(cells) > 2 else ""
        if phase and phase != WORK_ROW_PHASE:
            return phase.split("→")[-1].strip()
    return None


def append_log_row(path: Path, who: str, what: str, to_phase: str | None, when: str) -> str:
    """Append a row to the doc's `## Log` table; return the rendered row.

    A `to_phase` makes it a transition row — From is auto-filled from the doc's
    current phase, so callers name only the destination. No `to_phase` → a work
    row with `phase →` left as the em-dash sentinel.
    """
    path = Path(path)
    text = path.read_text(encoding="utf-8")
    if to_phase:
        frm = current_phase(text)
        phase_cell = f"{frm} → {to_phase}" if frm else f"→ {to_phase}"
    else:
        phase_cell = WORK_ROW_PHASE
    row = f"| {when} | {who} | {phase_cell} | {what} |"

    lines = text.splitlines()
    bounds = _log_section_bounds(lines)
    if not bounds:
        raise SystemExit(f"{path}: no `## Log` section to append to")
    table = _table_line_indices(lines, *bounds)
    if not table:
        raise SystemExit(f"{path}: `## Log` section has no table")
    lines.insert(table[-1] + 1, row)
    trailing = "\n" if text.endswith("\n") else ""
    path.write_text("\n".join(lines) + trailing, encoding="utf-8")
    return row


def _now() -> str:
    from datetime import datetime

    return datetime.now().strftime("%Y-%m-%d %H:%M")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="BuildLoop deterministic workflow helpers")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_next = sub.add_parser("next-id")
    p_next.add_argument("kind", choices=KINDS)
    p_next.add_argument(
        "--docs-dir",
        default=None,
        help="buildloop docs root (default: ./docs/buildloop or $BUILDLOOP_DOCS_DIR)",
    )

    p_docid = sub.add_parser("doc-id")
    p_docid.add_argument("kind", choices=KINDS)
    p_docid.add_argument("number", type=int)

    p_oq = sub.add_parser("open-questions")
    p_oq.add_argument("doc")

    p_phase = sub.add_parser("current-phase")
    p_phase.add_argument("doc")

    p_log = sub.add_parser("log")
    p_log.add_argument("doc")
    p_log.add_argument("who")
    p_log.add_argument("what")
    p_log.add_argument("--to", default=None, help="destination phase → makes this a transition row")
    p_log.add_argument("--when", default=None, help="override the timestamp (default: now)")

    args = parser.parse_args(argv)

    if args.cmd == "next-id":
        print(format_doc_id(args.kind, next_sequence(args.kind, docs_dir(args.docs_dir))))
        return 0
    if args.cmd == "doc-id":
        print(format_doc_id(args.kind, args.number))
        return 0
    if args.cmd == "open-questions":
        blocked = has_open_questions(Path(args.doc).read_text(encoding="utf-8"))
        print("open-questions" if blocked else "clean")
        return 1 if blocked else 0
    if args.cmd == "current-phase":
        phase = current_phase(Path(args.doc).read_text(encoding="utf-8"))
        print(phase if phase else "none")
        return 0
    if args.cmd == "log":
        print(append_log_row(Path(args.doc), args.who, args.what, args.to, args.when or _now()))
        return 0
    return 2  # pragma: no cover — unreachable: subparsers are required=True


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
