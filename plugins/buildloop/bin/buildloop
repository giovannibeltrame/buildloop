#!/usr/bin/env python3
"""Deterministic workflow helpers, bundled with the BuildLoop plugin.

The `buildloop:` skills are markdown orchestrations; the small deterministic
bits they rely on live here as one self-contained, dependency-free CLI, so the
skills call one command instead of re-deriving the logic each turn:

    buildloop next-id fix
    buildloop doc-id fix 22
    buildloop open-questions docs/buildloop/epics/epic-0030.md
    buildloop log <doc> "human, manual" "status 4 → 5"
    buildloop can-promote <cnst-doc> tests/e2e

Claude Code adds this plugin's `bin/` directory to the Bash tool's PATH while the
plugin is enabled, so `buildloop` is callable directly with no path or `python -m`.

Paths resolve against the **consuming project's working directory** (where Claude
runs), not this script's install location. The docs root defaults to
`./docs/buildloop` and is overridable with the `BUILDLOOP_DOCS_DIR` env var or the
`--docs-dir` flag.
"""

from __future__ import annotations

import argparse
import os
import re
import sys
from pathlib import Path

KIND_DIRS = {"epic": "epics", "fix": "bugfixes", "hyp": "hypotheses", "cnst": "constants"}


def docs_dir(override: str | None = None) -> Path:
    """The buildloop docs root, resolved against the consuming project's cwd."""
    if override:
        return Path(override)
    env = os.environ.get("BUILDLOOP_DOCS_DIR")
    if env:
        return Path(env)
    return Path.cwd() / "docs" / "buildloop"


def next_sequence(kind: str, root: Path) -> int:
    """Return the next zero-padded sequence number for a doc kind (1 if none)."""
    directory = Path(root) / KIND_DIRS[kind]
    pattern = re.compile(rf"{kind}-(\d+)\.md$")
    highest = 0
    if directory.exists():
        for path in directory.glob(f"{kind}-*.md"):
            match = pattern.search(path.name)
            if match:
                highest = max(highest, int(match.group(1)))
    return highest + 1


def format_doc_id(kind: str, number: int) -> str:
    return f"{kind}-{number:04d}"


def has_open_questions(text: str) -> bool:
    """True if the doc has an `## Open Questions` section carrying a bullet."""
    match = re.search(r"(?ims)^##\s+open questions\s*$(?P<body>.*?)(?:\n##\s+|\Z)", text)
    if not match:
        return False
    # A list item: a dash/asterisk bullet or a numbered item, carrying text.
    return bool(re.search(r"(?m)^\s*(?:[-*]|\d+\.)\s+\S", match.group("body")))


def format_log_line(date: str, tag: str, text: str) -> str:
    return f"- [{tag}] {date} {text}"


def append_log_entry(path: Path, line: str) -> None:
    """Insert a process-log line at the end of the doc's `## Process log` section.

    A doc may carry a trailing section (e.g. `## Refinement Outcome`) after the
    process log, so the entry is placed before the next `##` heading — not blindly
    at end-of-file. Falls back to EOF if there is no process-log section.
    """
    path = Path(path)
    text = path.read_text(encoding="utf-8")
    heading = re.search(r"(?im)^##\s+process log\s*$", text)
    if not heading:
        path.write_text(f"{text.rstrip(chr(10))}\n{line}\n", encoding="utf-8")
        return
    section_start = heading.end()
    nxt = re.search(r"(?m)^##\s+", text[section_start:])
    if nxt:
        boundary = section_start + nxt.start()
        section = text[section_start:boundary].rstrip("\n")
        new_text = f"{text[:section_start]}{section}\n{line}\n\n{text[boundary:]}"
    else:
        new_text = f"{text.rstrip(chr(10))}\n{line}\n"
    path.write_text(new_text, encoding="utf-8")


# --- constant lifecycle helpers (inlined so this CLI has zero dependencies) ---

_LABEL = re.compile(r"(?mi)^Label:\s*\*\*(?P<label>\w+)\*\*")
_CNST_ID = re.compile(r"cnst-(?P<num>\d+)", re.IGNORECASE)


def parse_label(text: str) -> str | None:
    """Return the constant's lifecycle label (Proposed / Active / …) or None."""
    match = _LABEL.search(text)
    return match.group("label") if match else None


def cnst_number(id_or_name: str) -> str | None:
    """Return the NNNN digits from a constant id or filename (e.g. cnst-0007)."""
    match = _CNST_ID.search(id_or_name)
    return match.group("num") if match else None


def e2e_matches(num: str, e2e_dir) -> list[Path]:
    """Return e2e test files under `e2e_dir` carrying constant number `num`."""
    e2e_dir = Path(e2e_dir)
    return list(e2e_dir.glob(f"*cnst*{num}*")) if e2e_dir.exists() else []


def promotion_blockers(cnst_text: str, cnst_id: str, e2e_dir: Path) -> list[str]:
    """Return reasons a constant cannot be promoted Proposed → Active (empty = OK).

    Two gates per the constant lifecycle in AGENTS.md §3.3: the constant must
    currently be Proposed, and it must have an e2e test under `e2e_dir`.
    """
    blockers: list[str] = []
    label = parse_label(cnst_text)
    if label != "Proposed":
        blockers.append(f"{cnst_id} is {label or 'unlabeled'}, not Proposed — nothing to promote")
    num = cnst_number(cnst_id) or cnst_id
    if not e2e_matches(num, e2e_dir):
        blockers.append(f"{cnst_id} has no e2e test under {e2e_dir} (expected *cnst*{num}*)")
    return blockers


def _today() -> str:
    from datetime import date

    return date.today().isoformat()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="BuildLoop deterministic workflow helpers")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_next = sub.add_parser("next-id")
    p_next.add_argument("kind", choices=KIND_DIRS)
    p_next.add_argument(
        "--docs-dir",
        default=None,
        help="buildloop docs root (default: ./docs/buildloop or $BUILDLOOP_DOCS_DIR)",
    )

    p_docid = sub.add_parser("doc-id")
    p_docid.add_argument("kind", choices=KIND_DIRS)
    p_docid.add_argument("number", type=int)

    p_oq = sub.add_parser("open-questions")
    p_oq.add_argument("doc")

    p_log = sub.add_parser("log")
    p_log.add_argument("doc")
    p_log.add_argument("tag")
    p_log.add_argument("text")
    p_log.add_argument("--date", default=None)

    p_promote = sub.add_parser("can-promote")
    p_promote.add_argument("doc")
    p_promote.add_argument("e2e_dir")

    args = parser.parse_args(argv)

    if args.cmd == "next-id":
        print(format_doc_id(args.kind, next_sequence(args.kind, docs_dir(args.docs_dir))))
        return 0
    if args.cmd == "doc-id":
        print(format_doc_id(args.kind, args.number))
        return 0
    if args.cmd == "open-questions":
        blocked = has_open_questions(Path(args.doc).read_text(encoding="utf-8"))
        print("open-questions" if blocked else "clean")
        return 1 if blocked else 0
    if args.cmd == "log":
        line = format_log_line(args.date or _today(), args.tag, args.text)
        append_log_entry(Path(args.doc), line)
        print(line)
        return 0
    if args.cmd == "can-promote":
        text = Path(args.doc).read_text(encoding="utf-8")
        cnst_id = Path(args.doc).stem
        blockers = promotion_blockers(text, cnst_id, Path(args.e2e_dir))
        if blockers:
            for blocker in blockers:
                print(f"BLOCKED {blocker}")
            return 1
        print(f"{cnst_id}: promotable")
        return 0
    return 2  # pragma: no cover — unreachable: subparsers are required=True


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
